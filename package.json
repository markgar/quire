{
  "name": "quire",
  "version": "0.1.0",
  "description": "An agent-native presentation format and local browser runtime",
  "keywords": ["presentation", "slides", "markdown", "deck", "file-system-access"],
  "license": "MIT",
  "author": "Mark Garner",
  "homepage": "https://github.com/markgar/quire#readme",
  "repository": { "type": "git", "url": "git+https://github.com/markgar/quire.git" },
  "bugs": { "url": "https://github.com/markgar/quire/issues" },
  "type": "module",
  "private": true,
  "engines": { "node": ">=18" },
  "files": ["src", "skills", "quire.html", "SPEC.md", "LICENSE"],
  "scripts": {
    "test": "node test/conformance.js",
