{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "lib": ["es2022", "dom"]
  },
  "include": ["src/**/*.js", "src/**/*.d.ts", "test/**/*.js", "tools/**/*.js"]
}
